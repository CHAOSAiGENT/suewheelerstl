{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "F=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$F\" =~ \\.(tsx?|ts)$ ]]; then D=\"${CLAUDE_PROJECT_DIR:-}\"; if [ -z \"$D\" ] || [ ! -d \"$D\" ]; then echo \"[hook] CLAUDE_PROJECT_DIR unusable ('$D') - typecheck/lint NOT run\" >&2; exit 0; fi; cd \"$D\" && npx tsc --noEmit 2>&1 | head -20; fi; exit 0"
          },
          {
            "type": "command",
            "command": "F=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$F\" =~ \\.(tsx?|ts)$ ]]; then D=\"${CLAUDE_PROJECT_DIR:-}\"; if [ -z \"$D\" ] || [ ! -d \"$D\" ]; then echo \"[hook] CLAUDE_PROJECT_DIR unusable ('$D') - typecheck/lint NOT run\" >&2; exit 0; fi; cd \"$D\" && npx next lint --file \"$F\" 2>&1 | head -20; fi; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "F=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$F\" =~ \\.env ]] || [[ \"$F\" =~ supabase/migrations/ ]]; then echo \"BLOCKED: .env and supabase/migrations require manual review \u2014 do not edit via Claude\" >&2; exit 2; fi; exit 0"
          }
        ]
      }
    ]
  },
